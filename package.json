{
  "name": "calmview",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test extension",
    "package": "node scripts/build.mjs --store",
    "icons": "node scripts/render-icons.mjs",
    "update-lists": "node scripts/update-lists.mjs",
    "store-assets": "pnpm build && ASSETS=1 playwright test store-assets",
    "demo-video": "pnpm build && DEMO=1 playwright test demo",
    "release": "node scripts/release.mjs",
    "publish-store": "node scripts/publish-store.mjs",
    "export-public": "node scripts/export-public.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.6",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@mono/cross-promo": "workspace:*"
  },
  "description": "Calmview: a fast, simple, private ad blocker for Chrome, YouTube included.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/SonarSystems/calmview"
  },
  "packageManager": "pnpm@9.15.0"
}
